/* CGM_FOTOS_SEQUENCIAS_V1 */
#umovFotosModal.cgmFotosV1 .ufDialog {
  width: min(1380px, 98vw);
}
#umovFotosModal.cgmFotosV1 .ufBody {
  overflow: auto;
}
#umovFotosModal.cgmFotosV1 #umovFotosStatus,
#umovFotosModal.cgmFotosV1 #umovFotosGrid {
  display: none;
}
#cgmFotosComparacao {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 14px;
}
#cgmFotosComparacao.comAnterior {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
#cgmFotosComparacao .cgmFotoPainel {
  min-width: 0;
  padding: 13px;
  background: #fff;
  border: 1px solid #cbddeb;
  border-radius: 9px;
}
#cgmFotosComparacao .cgmFotoPainel[hidden] {
  display: none !important;
}
#cgmFotosComparacao header {
  margin-bottom: 12px;
  color: #125286;
  font-size: 15px;
}
#cgmFotosComparacao label {
  display: block;
  margin: 9px 0 5px;
  color: #315d83;
  font-size: 12px;
}
#cgmFotosComparacao select {
  width: 100%;
  min-height: 36px;
  padding: 7px;
  border: 1px solid #b9cfe0;
  border-radius: 5px;
  background: #fff;
}
#cgmFotosComparacao .cgmFotoIdentificacao {
  min-height: 35px;
  padding: 9px;
  background: #eef5fb;
  border-radius: 5px;
  color: #125286;
}
#cgmFotosComparacao .cgmFotoStatus {
  min-height: 24px;
  padding: 8px 0;
  font-size: 12px;
  color: #536c80;
}
#cgmFotosComparacao .cgmFotoImagem {
  min-height: 240px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef3f8;
  border-radius: 7px;
}
#cgmFotosComparacao .cgmFotoImagem img {
  display: block;
  width: 100%;
  height: min(43vh, 420px);
  object-fit: contain;
  cursor: zoom-in;
}
#cgmFotosComparacao nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
}
#cgmFotosComparacao nav button {
  padding: 8px 12px;
  border: 1px solid #a7c9e7;
  border-radius: 5px;
  background: #f0f7fd;
  color: #125286;
  cursor: pointer;
}
#cgmFotosComparacao nav span {
  font-size: 12px;
  color: #536c80;
}
@media(max-width: 700px) {
  #cgmFotosComparacao.comAnterior {
    grid-template-columns: 1fr;
  }
}